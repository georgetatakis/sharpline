# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres credentials (used by Docker Compose to create the database)
POSTGRES_USER=sharpline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sharpline

# SQLAlchemy connection string used by the backend
DATABASE_URL=postgresql+psycopg://sharpline:change-me@localhost:5432/sharpline

# The Odds API — https://the-odds-api.com (not needed until the odds poller step)
ODDS_API_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
